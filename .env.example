# Vercel Blob store (Vercel dashboard: Storage -> Blob -> Create, then connect it to this project; this is filled in automatically)
BLOB_READ_WRITE_TOKEN=
# Optional: Google sign-in for Search Console + GA4 (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application",
# authorized redirect URI: https://<your-app>.vercel.app/api/google/callback). Without these, the app runs on Moz data only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a long random string used to encrypt the Google sign-in cookie (defaults to one derived from GOOGLE_CLIENT_SECRET)
SESSION_SECRET=
# Optional: domains whose site index the daily cron keeps fresh (comma-separated)
PRECRAWL_DOMAINS=
# Optional: set to 1 locally to use canned Moz/Claude/Google responses (UI testing without keys)
MOCK=
